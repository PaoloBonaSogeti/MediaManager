<Project>
  <!-- Resolve Android build toolchain paths for MAUI mobile projects.
       These defaults point to the recommended local tool locations.
       Override by setting environment variables ANDROID_SDK_ROOT or JAVA_HOME_21,
       or pass -p:JavaSdkDirectory / -p:AndroidSdkDirectory on the command line. -->
  <PropertyGroup>
    <_AndroidSdkFromEnv>$(ANDROID_SDK_ROOT)</_AndroidSdkFromEnv>
    <_AndroidSdkDefault>$(LOCALAPPDATA)\Android\Sdk</_AndroidSdkDefault>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and '$(_AndroidSdkFromEnv)' != ''">$(_AndroidSdkFromEnv)</AndroidSdkDirectory>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == ''">$(_AndroidSdkDefault)</AndroidSdkDirectory>

    <_Jdk21Default>C:\Program Files\Microsoft\jdk-21.0.10.7-hotspot</_Jdk21Default>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('$(_Jdk21Default)')">$(_Jdk21Default)</JavaSdkDirectory>
  </PropertyGroup>
</Project>
